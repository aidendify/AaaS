# Copy this file to .env and fill it in. Never commit .env.

# --- Database ---
# Postgres connection string: Neon (Neon dashboard → Connection details, or Vercel → Storage → Neon) or any Postgres.
# Leave empty to keep data in data/kv.json on this computer (fine for one self-hosted server).
DATABASE_URL=
# Hosted deploy: HOSTED=1 (or NODE_ENV=production, or Vercel) makes DATABASE_URL required; the server refuses to start
# on the file store. ALLOW_FILE_STORE=1 overrides that for a single-server test.
HOSTED=
# Optional: keep the tables in their own Postgres schema (default: public).
DATABASE_SCHEMA=
# Optional: force the driver (neon = HTTPS, used automatically for *.neon.tech; pg = TCP pool for everything else).
DB_DRIVER=
# Optional: pg pool size (default 10).
DB_POOL_MAX=

# --- Sign-in ---
# Long random text used to sign session tokens. Required on Vercel. Example: openssl rand -hex 32
SESSION_SECRET=
# Admin account. There is NO default password. Either leave ADMIN_PASSWORD empty and create the admin at
# http://localhost:3000/setup with the one-time code printed in the server log, or set a strong one here
# (12+ characters, not a common password) before the first start. A weak value is ignored.
ADMIN_EMAIL=admin@aidentify.local
ADMIN_PASSWORD=
# Optional pricing-team staff account, created only when TEAM_PASSWORD is set (same rules).
TEAM_EMAIL=team@aidentify.local
TEAM_PASSWORD=

# --- AI agents (optional) — set one or both ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# OpenRouter: any model on openrouter.ai (e.g. anthropic/claude-sonnet-4.5, deepseek/deepseek-chat, openai/gpt-4o-mini).
OPENROUTER_API_KEY=
# The orchestrator needs a model that supports tool calling
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Faster replies (still good with tools): anthropic/claude-haiku-4.5 or google/gemini-2.5-flash. Most accurate: anthropic/claude-sonnet-4.5
# Which to use first when several keys are set: anthropic (default) or openrouter. The others are fallbacks.
AI_PROVIDER=
# Web search is on with no key (DuckDuckGo). Optional: better results with a Tavily key (tavily.com). WEB_SEARCH=off disables it.
TAVILY_API_KEY=
# Secret for the routines endpoint /api/cron/tick (needed on Vercel; npm start runs routines by itself every minute)
CRON_SECRET=
# Automatic workflow emails per account per day. Unset means 50. 0 means none. The ceiling never goes above 500.
WORKFLOW_SEND_DAILY_MAX=

# --- Gmail: send follow-ups and read mail (optional) ---
# Each user can connect their own Gmail in Plugins → Connectors → Gmail with a Gmail address + app password
# (Google Account → Security → 2-Step Verification → App passwords). Or set one Gmail for the whole server:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Local server ---
# Demo customer is created only when DEMO_MODE=1. Leave this unset on a public server.
# DEMO_MODE=1
# Clinic team (/clinic): the "Explore the sample clinic" button is on for a local server and off when hosted.
# Set CLINIC_DEMO=1 to force it on (use this on a staging Vercel project), or CLINIC_DEMO=0 to force it off.
# It does not print a password. With no AI key, drafts and the sample clinic still work; the usage meter stays at 0.
# CLINIC_DEMO=
# Free trial on /clinic is 14 days and does not take a card. Leave unset. 0 makes a new account read-only immediately.
# CLINIC_TRIAL_DAYS=14
# Eka.care connector (optional). Create the client id and secret in the Eka console.
# Docs: https://developer.eka.care/api-reference/authorization/client-login
# Values stay in this file on the server. Never commit them. The sample clinic does not call Eka.
# EKA_CLIENT_ID=
# EKA_CLIENT_SECRET=
# EKA_BASE_URL=https://api.eka.care
# EKA_CLINIC_ID=
# Other clinic software can POST /api/clinic/connectors/webhook/<form token>
# with header X-AaaS-Connector-Secret. Leave the secret unset and that URL stays closed.
# CLINIC_CONNECTOR_WEBHOOK_SECRET=
# Clinic invoice payment links (optional). Test mode only: the key id must start with rzp_test_.
# A live key is ignored and the invoice uses a UPI deep link. Never commit these values.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CLINIC_PAY_MOCK=on is only for tests, and only together with AI_PROVIDER=mock and AI_MOCK=on.
# Official WhatsApp for approved clinic drafts. Leave unset and drafts stay wa.me links. Nothing sends without approval.
# CLINIC_WA_PROVIDER=meta
# CLINIC_WA_META_TOKEN=
# CLINIC_WA_META_PHONE_ID=
# CLINIC_WA_META_APP_SECRET=
# CLINIC_WA_META_VERIFY_TOKEN=
# CLINIC_WA_PROVIDER=gupshup
# CLINIC_WA_GUPSHUP_API_KEY=
# CLINIC_WA_GUPSHUP_SOURCE=
# CLINIC_WA_GUPSHUP_APP_NAME=
# CLINIC_WA_WEBHOOK_SECRET=
# CLINIC_WA_TEMPLATE=aaas_note
# CLINIC_WA_TEMPLATE_LANG=en
# CLINIC_WA_MOCK=on is only for tests, and only together with AI_PROVIDER=mock and AI_MOCK=on.
# Vercel staging for /clinic (a new project, not aidentify and not aidentify-demo). Put values in the Vercel UI, not in git.
# Required: SESSION_SECRET, DATABASE_URL, APP_URL, CRON_SECRET.
# Optional: CLINIC_DEMO=1, CLINIC_TRIAL_DAYS, OPENROUTER_API_KEY, OPENROUTER_MODEL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, CLINIC_WA_PROVIDER and the Meta or Gupshup vars above.
# Leave ALLOW_FILE_STORE unset on Vercel. See README → Small-business team.
# DEMO_USER_EMAIL=demo@aidentify.local
# DEMO_USER_PASSWORD=             # required for the demo account; there is no default
# Sign-in rate limit. Leave unset (or on) on any server other people can reach. off is only for a private demo on one computer.
# RATE_LIMIT=off
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 on a VPS so the phone and Windows apps can reach it.
HOST=127.0.0.1
# Real browser for the Research and Browser agents. On a VPS: npx playwright install chromium
# Optional path if Chromium is not in the default Playwright folder:
# BROWSER_EXECUTABLE=

# --- Social media through Buffer (optional) ---
# One key reaches every social account connected in Buffer (X, LinkedIn, Facebook, Instagram, Threads, Bluesky…).
# Get it at publish.buffer.com/settings/api. Each user can instead paste their own key in Plugins → Connectors → Buffer.
BUFFER_API_KEY=

# --- Connectors (Plugins → Connectors) ---
# Easiest: Composio managed sign-in. One key (app.composio.dev → Settings → API keys) turns on Gmail, Calendar, Drive,
# Sheets, Outlook, GitHub, Slack, Notion, HubSpot, Jira, Linear, Asana, Dropbox, Box, Zoom, Shopify and more, with no
# Google/Slack/GitHub app registration. A provider's own CLIENT_ID/SECRET below, when set, takes priority over Composio.
COMPOSIO_API_KEY=
# Optional: pin an existing auth config per toolkit, e.g. COMPOSIO_AUTH_CONFIG_GMAIL=ac_xxx (otherwise one is created automatically)
# Public address of this app, used to build the sign-in return URL. Register this exact URL with every provider:
#   <APP_URL>/api/connectors/callback
APP_URL=http://localhost:3000
# One app per provider. A connector shows "isn't set up yet" until its pair is filled in.
GOOGLE_CLIENT_ID=          # "Continue with Google" sign-in + Gmail, Calendar, Drive, Sheets connectors (console.cloud.google.com → APIs & Services → Credentials).
                           # Redirect URIs to register: <APP_URL>/api/auth/google/callback and <APP_URL>/api/connectors/callback
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=       # Microsoft 365, Outlook, Teams (entra.microsoft.com → App registrations)
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=          # github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=           # api.slack.com/apps
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=          # notion.so/my-integrations (public integration)
NOTION_CLIENT_SECRET=
# Same pattern for: DROPBOX, BOX, ZOOM, HUBSPOT, SALESFORCE, ASANA, ATLASSIAN (Jira + Confluence), LINEAR, FIGMA,
# CANVA, CALENDLY, AIRTABLE, INTUIT (QuickBooks), MAILCHIMP, XERO, DOCUSIGN, ZENDESK, SHOPIFY, INTERCOM.
# Stripe, Finance (Plaid), Vercel, Wix, Trello, Twilio, WhatsApp, PostgreSQL and Granola use an API key the customer pastes in.

# --- India-first channels and the front desk (docs/CHANNELS.md) ---
# WhatsApp and SMS credentials are saved per account in the app, encrypted like a bring-your-own AI key.
# These are optional overrides for tests and for pointing the adapters at a fake server. Leave them empty in production.
# CHANNELS_MOCK=on          # with AI_MOCK=on, allows a mock inbound email and a mock calendar link
# WIDGET_RATE_MAX=30        # public web chat messages per 15 minutes, per visitor address and per widget
# WHATSAPP_API_BASE=        # default https://graph.facebook.com/v21.0
# TWILIO_API_BASE=          # default https://api.twilio.com
# MSG91_API_BASE=           # default https://control.msg91.com/api/v5/sms
# GMAIL_API_BASE=           # default https://gmail.googleapis.com
# GCAL_API_BASE=            # default https://www.googleapis.com/calendar/v3
# Webhook URLs to register (the account is chosen from the number you saved, not from the URL):
#   <APP_URL>/api/channels/whatsapp/webhook
#   <APP_URL>/api/channels/sms/webhook
# Telegram and Slack are saved per account on the Inbox page (a BotFather token, or a Slack bot token + signing secret).
# The webhook URL is shown after you save. It contains a hook id, not the token.
#   <APP_URL>/api/channels/telegram/webhook/<hook>
#   <APP_URL>/api/channels/slack/webhook/<hook>
# WhatsApp QR is a beta, owner-only, and off unless this is on. It needs a long-running server.
# It does not run on Vercel. It never messages customers. See docs/CHANNELS.md.
# WHATSAPP_QR=

# --- Slack bot (optional, Socket Mode: no public URL needed). See docs/slack.md ---
# All four must be set or the bot stays off. It obeys only SLACK_OWNER_USER_ID.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_OWNER_USER_ID=
# The AaaS account whose agents and boards the bot uses
SLACK_ACCOUNT_EMAIL=
# Optional: agent id that answers DMs (default: lead of the orchestrator group)
# SLACK_AGENT_ID=
# Optional: channel id (e.g. C0123ABCD) for review cards, failures and briefs; DMs then stay conversation-only.
# Invite the bot to that channel first (/invite @AaaS in the channel).
# SLACK_NOTIFY_CHANNEL=
SLACK_SIGNING_SECRET=

# --- Factory publishing (optional; agents with the "publish" tool). Always approval-gated. See docs/factory-tools.md ---
GITHUB_TOKEN=
# Org or user to create repos under (default: the token's user)
GITHUB_OWNER=
GUMROAD_ACCESS_TOKEN=

# Max time for one model call in ms (default 180000)
# LLM_TIMEOUT_MS=180000

# ---- Agents' browser (lib/browser.js) ----
# Keep one persistent Chromium profile so agents reuse sites the owner signed in to himself.
# Sign in once with: npm run browser:login -- https://mail.google.com https://app.gumroad.com
# BROWSER_PROFILE_DIR=data/browser-profile
# BROWSER_HEADLESS=true        # false shows the agents' window on DISPLAY / BROWSER_DISPLAY
# BROWSER_DISPLAY=:1

# ---- Slack connection health (lib/slack.js) ----
# SLACK_HEARTBEAT_MIN=15       # heartbeat log line every N minutes
# SLACK_WATCHDOG_SEC=60        # force a reconnect (then restart) if the socket stays down this long

# Remote browser (Slack "open browser"): idle minutes before auto-close, and the public tunnel
# REMOTE_BROWSER=on            # off by default; always off on Vercel
# REMOTE_BROWSER_IDLE_MIN=20
# REMOTE_BROWSER_MAX_MIN=60            # hard limit per session, whatever the activity
# REMOTE_BROWSER_OPENS_PER_HOUR=6
# REMOTE_BROWSER_TUNNEL=auto   # auto | ngrok | cloudflared | none
# NGROK_AUTHTOKEN=             # free at dashboard.ngrok.com; needed where outbound port 7844 is blocked

# ---- Settings page (/settings) ----
# Anything below can also be set in /settings. Saved values there win over .env.
# SETTINGS_OWNERS=you@example.com        # extra emails allowed to open /settings (default: SLACK_ACCOUNT_EMAIL)
# More providers (each also has _MODEL and _BASE_URL)
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Model routing: provider:model pins a provider
# AI_MODEL_CHEAP=
# AI_MODEL_STRONG=
# AI_FALLBACKS=openrouter:openai/gpt-4o-mini
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=2000
# Monthly cap on estimated spend
# SPEND_CAP_MONTH_USD=
# SPEND_CAP_ACTION=block                 # block | warn
# AGENT_MAX_STEPS=7
# APP_TIMEZONE=Asia/Kolkata
# APPROVAL_EMAIL=ask                     # ask | block (also SOCIAL, ACTION, BROWSER, REPLY, GITHUB, GUMROAD)
