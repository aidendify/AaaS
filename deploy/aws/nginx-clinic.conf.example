# Example for an existing EC2 box. Replace the server name.
# AaaS listens on 127.0.0.1:3000 only. nginx is the public door.
# Certbot can turn the port-80 server into the TLS server: sudo certbot --nginx -d clinic.example.com

server {
    listen 80;
    server_name clinic.example.com;

    client_max_body_size 8m;

    location = /api/health {
        proxy_pass http://127.0.0.1:3000/api/health;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
