{
  "name": "agentsphere-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Windows window onto a hosted AgentSphere. The server address is changeable.",
  "main": "main.js",
  "author": "AgentSphere",
  "scripts": {
    "start": "electron .",
    "pack:dir": "electron-builder --win dir --x64",
    "pack": "electron-builder --win nsis --x64",
    "installer": "makensis installer.nsi"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.agentsphere.desktop",
    "productName": "AgentSphere",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json", "icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AgentSphere",
      "artifactName": "AgentSphere-Setup-${version}.exe"
    }
  }
}
